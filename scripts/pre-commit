#!/usr/bin/env bash
set -euo pipefail

# To bypass this hook in an emergency: git commit --no-verify
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Auto-detect JAVA_HOME from common Android Studio JDK locations
if [ -z "${JAVA_HOME:-}" ]; then
    for candidate in \
        "$HOME/.jdks"/jbr-* \
        "/c/Program Files/Android/Android Studio/jbr" \
        "/Applications/Android Studio.app/Contents/jbr/Contents/Home"; do
        if [ -x "$candidate/bin/java" ]; then
            export JAVA_HOME="$candidate"
            break
        fi
    done
fi

# Only run if Kotlin files are staged
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '\.kt$' || true)
if [ -z "$STAGED" ]; then
    exit 0
fi

echo ""
echo "=== [1/3] ktlint ==="
if ! ./gradlew ktlintCheck; then
    echo "✗ ktlint fehlgeschlagen — Commit blockiert"
    exit 1
fi
echo "✓ ktlint OK"

echo ""
echo "=== [2/3] Unit Tests ==="
if ! ./gradlew test; then
    echo "✗ Unit Tests fehlgeschlagen — Commit blockiert"
    exit 1
fi
echo "✓ Tests OK"

echo ""
echo "=== [3/3] KI Code-Review ==="
DIFF=$(git diff --cached -- '*.kt')
if ! RESULT=$(echo "$DIFF" | claude -p "$(cat scripts/review-agent-prompt.md)" 2>&1); then
    echo "✗ KI-Review: Claude-Aufruf fehlgeschlagen — Commit blockiert"
    exit 1
fi

echo "$RESULT"

if echo "$RESULT" | grep -q "^EXIT:1"; then
    echo ""
    echo "✗ KI-Review: FEHLER gefunden — Commit blockiert"
    exit 1
elif ! echo "$RESULT" | grep -q "^EXIT:0"; then
    echo "✗ KI-Review: Ungültige Ausgabe (kein EXIT-Status) — Commit blockiert"
    exit 1
fi

echo ""
echo "✓ Alle Checks bestanden"
exit 0
