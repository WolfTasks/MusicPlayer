<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup / device-transfer rules for Android 12 (API 31) and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   Same exclusions as backup_rules.xml (rationale there): Room database and
   SharedPreferences are neither backed up to the cloud nor copied on device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
